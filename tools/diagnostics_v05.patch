     SecureSessionStore(Context ctx) {
         prefs = ctx.getSharedPreferences("spd_siwc_auth_v1", Context.MODE_PRIVATE);
+    }
+    /** Issued OAuth client ID is a registration identifier, not a bearer credential. */
+    String issuedClientId() { return prefs.getString("issued_client_id", null); }
+    void rememberIssuedClientId(String value) {
+        if (value == null || !value.startsWith("oaiapp_"))
+            throw new IllegalArgumentException("Invalid issued client ID");
+        if (!prefs.edit().putString("issued_client_id", value).commit())
+            throw new IllegalStateException("Failed to retain issued client ID");
     }
